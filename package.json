{
  "name": "brover-electron-app",
  "version": "0.1.0",
  "private": true,
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "concurrently \"bun:dev:renderer\" \"bun:dev:main\" \"bun:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsup src/main/main.ts src/preload/preload.ts --format cjs --out-dir dist-electron --watch --external electron",
    "dev:electron": "wait-on http-get://127.0.0.1:5173 file:dist-electron/main/main.js file:dist-electron/preload/preload.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "bun run build:renderer && bun run build:main",
    "build:renderer": "vite build",
    "build:main": "tsup src/main/main.ts src/preload/preload.ts --format cjs --out-dir dist-electron --external electron",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.reporter=text --coverage.reporter=lcov --coverage.reporter=html --coverage.reporter=json-summary",
    "test:coverage:text": "vitest run --coverage --coverage.reporter=text",
    "coverage:badge": "node scripts/generateCoverageBadge.mjs coverage/coverage-summary.json .badge-dist/coverage-badge.svg",
    "test:e2e": "bun run build && bunx playwright test",
    "tsc": "bunx tsc --noEmit",
    "lint": "eslint src --ext .ts,.tsx",
    "tscontext": "/opt/homebrew/bin/bun /Users/eber/dev/tscontext/src/cli.ts extract --repo . --out .tscontext/code-context --profile default",
    "precommit": "bun run tsc && bun run test && bun run tscontext && git add .tscontext/code-context.toon .tscontext/code-context.md",
    "postinstall": "[ -d .git ] && git config core.hooksPath .githooks && chmod +x .githooks/pre-commit || true"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "keytar": "^7.9.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.7",
    "autoprefixer": "^10.4.22",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^39.2.3",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.0",
    "vitest": "^4.0.8",
    "wait-on": "^9.0.3"
  }
}
